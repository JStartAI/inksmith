{
  "name": "Document",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Reference to parent project"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent folder/document ID for tree structure"
    },
    "title": {
      "type": "string",
      "description": "Document or folder title"
    },
    "type": {
      "type": "string",
      "enum": [
        "folder",
        "document"
      ],
      "default": "document"
    },
    "category": {
      "type": "string",
      "enum": [
        "manuscript",
        "research",
        "front_matter",
        "back_matter",
        "notes",
        "trash"
      ],
      "default": "manuscript"
    },
    "content": {
      "type": "string",
      "description": "Rich text content (HTML)"
    },
    "synopsis": {
      "type": "string",
      "description": "Brief synopsis for corkboard view"
    },
    "notes": {
      "type": "string",
      "description": "Author notes for this document"
    },
    "label": {
      "type": "string",
      "enum": [
        "none",
        "red",
        "orange",
        "yellow",
        "green",
        "blue",
        "purple"
      ],
      "default": "none"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "draft",
        "revised",
        "final"
      ],
      "default": "todo"
    },
    "word_count": {
      "type": "number",
      "default": 0
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Order within parent"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name"
    }
  },
  "required": [
    "project_id",
    "title",
    "type"
  ]
}