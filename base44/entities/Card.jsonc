{
  "name": "Card",
  "type": "object",
  "properties": {
    "world_id": {
      "type": "string",
      "description": "Referencia al mundo"
    },
    "type_id": {
      "type": "string",
      "description": "Referencia al CardType"
    },
    "type_name": {
      "type": "string",
      "description": "Nombre del tipo (desnormalizado)"
    },
    "type_icon": {
      "type": "string",
      "description": "Icono del tipo"
    },
    "name": {
      "type": "string",
      "description": "Nombre de la ficha"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nombres alternativos"
    },
    "cover_image": {
      "type": "string",
      "description": "URL imagen de portada"
    },
    "wiki_visible": {
      "type": "boolean",
      "default": true
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "parent_card_id": {
      "type": "string",
      "description": "ID de la ficha padre (anidamiento)"
    },
    "folder_name": {
      "type": "string",
      "description": "Carpeta en el sidebar"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Array de {name, type, value}"
    },
    "content": {
      "type": "string",
      "description": "Contenido de texto enriquecido"
    },
    "synopsis": {
      "type": "string",
      "description": "Sinopsis corta"
    }
  },
  "required": [
    "world_id",
    "name"
  ]
}